# Backend environment variables (prefix: TERRA_). Copy to .env for local runs.
# When using docker-compose, these are provided by the root .env / compose file.

TERRA_APP_ENV=development
TERRA_DEBUG=true
TERRA_LOG_LEVEL=INFO
TERRA_LOG_JSON=false

# PostgreSQL / PostGIS
TERRA_POSTGRES_HOST=localhost
TERRA_POSTGRES_PORT=5432
TERRA_POSTGRES_USER=terra
TERRA_POSTGRES_PASSWORD=terra
TERRA_POSTGRES_DB=terra
# TLS mode for managed Postgres (Neon et al.): require | verify-full | …
# Unset keeps the driver default ("prefer"), right for local containers.
# TERRA_POSTGRES_SSLMODE=require

# Redis
TERRA_REDIS_URL=redis://localhost:6379/0

# Fetch hot path (SRS §23, §7.1). The fetch-result cache is a read-through
# Redis cache keyed per connector/field at a rounded coordinate, expiring on
# each dataset's declared TTL; it is fail-open (Redis down = cache misses).
# The deadlines turn a stalled upstream into typed nulls / a 504 instead of a
# hung request; the concurrency bound keeps slow GEE calls from exhausting the
# shared thread pool.
# TERRA_FETCH_CACHE_ENABLED=true
# TERRA_FETCH_CACHE_COORD_PRECISION=4
# TERRA_GEE_MAX_CONCURRENCY=8
# TERRA_FETCH_DEADLINE_SECONDS=20.0
# TERRA_ASK_DEADLINE_SECONDS=60.0
# How long a /ask answer is cached under its exact (question, coordinate) key,
# so repeat identical questions (e.g. the Ask page's example prompts) don't
# spend a second LLM call. 0 disables the cache.
# TERRA_ASK_CACHE_TTL_SECONDS=3600

# CORS. cors_origins is a JSON list; the frontend is same-origin behind Nginx so
# it needs no entry — set this only for a separate browser app. '*' is a dev
# convenience and is REJECTED in production; use '[]' for same-origin only.
# allow_credentials is off (the API uses bearer tokens, not cookies) and can
# never be paired with '*'.
# TERRA_CORS_ORIGINS=["*"]
# TERRA_CORS_ALLOW_CREDENTIALS=false

# Config files directory (defaults to <repo>/configs)
# TERRA_CONFIG_DIR=/configs

# Spatial data seed directory (defaults to <repo>/datasets/telangana)
# TERRA_SEED_DATA_DIR=/datasets/telangana
# Seed hand-authored dev fixtures (the sample cadastral parcel). OFF by default
# and rejected in production — synthetic data must never be served under an
# authoritative citation. Set true locally to demo the cadastral fields.
# TERRA_ENABLE_DEV_FIXTURES=false

# Google Earth Engine service-account auth (SRS §19.3).
# See docs/google_earth_engine_setup.md for the Google Cloud setup steps.
# Keep the key in the gitignored <repo>/secrets/ directory — never commit it.
# TERRA_EARTH_ENGINE_SERVICE_ACCOUNT=terra-gee@<project>.iam.gserviceaccount.com
# TERRA_EARTH_ENGINE_KEY_FILE=/absolute/path/to/secrets/<key>.json
# On a PaaS free tier with no persistent disk (e.g. Render), set the key's raw
# JSON content in TERRA_EARTH_ENGINE_KEY_JSON instead of TERRA_EARTH_ENGINE_KEY_FILE:
# TERRA_EARTH_ENGINE_KEY_JSON={"type":"service_account","project_id":"...", ...}
# TERRA_EARTH_ENGINE_PROJECT=<gcp-project-id>

# AI pipeline (SRS §9, §14, §6.5): the Planner and Synthesizer for POST /api/v1/ask.
# Model is a LiteLLM route; the provider key is read from the provider's own env
# var (e.g. ANTHROPIC_API_KEY / OPENAI_API_KEY) unless TERRA_LLM_API_KEY is set.
# TERRA_LLM_MODEL=anthropic/claude-opus-4-8
# TERRA_LLM_TEMPERATURE=0.0
# TERRA_LLM_MAX_TOKENS=1024
# TERRA_LLM_TIMEOUT=30.0
# TERRA_LLM_API_KEY=

# Observability (SRS §27). Prometheus metrics at /metrics are on by default.
# OpenTelemetry tracing is opt-in — set both flags to export spans via OTLP/HTTP.
# TERRA_METRICS_ENABLED=true
# TERRA_OTEL_ENABLED=false
# TERRA_OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318
# TERRA_OTEL_SERVICE_NAME=terra-backend

# Gateway rate limiting (SRS §13.19) + request hardening (SRS §29.1).
# Per-client-IP budget applied to /fetch and /ask, regardless of auth.
# TERRA_RATE_LIMIT_ENABLED=true
# TERRA_RATE_LIMIT_PER_MINUTE=120
# TERRA_MAX_REQUEST_BODY_BYTES=1048576
# Trust proxy client-IP headers (X-Real-IP / X-Forwarded-For) for rate-limit
# keying. Enable ONLY behind a trusted reverse proxy (e.g. Nginx, which sets a
# trustworthy X-Real-IP). Direct exposure makes these headers spoofable, so the
# default is off. docker-compose.prod.yml sets this to true.
# TERRA_TRUST_PROXY_HEADERS=false

# End-user accounts / login (SRS §13.20). Email/password sign-in works out of
# the box (accounts live in Postgres, passwords hashed with scrypt). A signed-in
# user's session is a bearer token that also authorizes /fetch and /ask.
# TERRA_ACCOUNT_SESSION_TTL_DAYS=30
# TERRA_AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10   # brute-force guard, per client IP
# Where the Google callback redirects after login (your frontend origin):
# TERRA_FRONTEND_BASE_URL=http://localhost:3000
# "Sign in with Google" (optional). Create a Web-app OAuth client at
# https://console.cloud.google.com/apis/credentials and add
# {TERRA_AUTH_ISSUER_URL}/api/v1/account/google/callback as a redirect URI.
# The button appears only when both are set.
# TERRA_GOOGLE_OAUTH_CLIENT_ID=
# TERRA_GOOGLE_OAUTH_CLIENT_SECRET=
