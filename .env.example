# Root environment for docker-compose. Copy to .env to override the dev defaults.
# (All values have sane defaults in docker-compose.yml, so .env is optional.)

# PostgreSQL / PostGIS
POSTGRES_USER=terra
POSTGRES_PASSWORD=terra
POSTGRES_DB=terra
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Service ports (host side)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --------------------------------------------------------------------------- #
# Backend application settings (TERRA_* — read from backend/.env)             #
# These override the defaults in app/core/config.py. All are optional.        #
# --------------------------------------------------------------------------- #

# Authentication (SRS §13.20, §13.19). Auth is OFF by default so metadata,
# /fetch, and /ask stay open (the browser UX + gate rely on this). Turn it on
# to require a bearer token on /fetch and /ask; metadata stays public.
# TERRA_AUTH_ENABLED=false
# Bootstrap credential guarding token management (POST /auth/tokens, device
# approval). Required to mint tokens; never expose it to clients.
# TERRA_AUTH_ADMIN_TOKEN=change-me-please
# Default per-token request budget (requests/minute, §13.19).
# TERRA_AUTH_DEFAULT_RATE_LIMIT_PER_MINUTE=120
# Default lifetime (days) for issued tokens; omit for non-expiring.
# TERRA_AUTH_TOKEN_TTL_DAYS=
# Public base URL used as the OAuth issuer / resource identifier.
# TERRA_AUTH_ISSUER_URL=http://localhost:8000
# Back ephemeral auth state (codes, rate counters) with Redis instead of the
# in-process store (required for multi-instance deployments).
# TERRA_AUTH_USE_REDIS=false

# MCP server (SRS §34). The server is a thin client over the REST API and is
# run separately: `python -m app.mcp` (stdio) or `--transport streamable-http`.
# TERRA_MCP_API_BASE_URL=http://localhost:8000/api/v1
# Bearer token the MCP server sends to the protected /fetch and /ask endpoints
# (only needed when TERRA_AUTH_ENABLED=true).
# TERRA_MCP_API_TOKEN=
# TERRA_MCP_TRANSPORT=stdio        # stdio | streamable-http
# TERRA_MCP_HTTP_HOST=127.0.0.1
# TERRA_MCP_HTTP_PORT=8765

# Observability (SRS §27). Metrics at /metrics are on by default; tracing opt-in.
# TERRA_METRICS_ENABLED=true
# TERRA_OTEL_ENABLED=false
# TERRA_OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318

# Gateway rate limiting (SRS §13.19) + request-body guard (SRS §29.1).
# TERRA_RATE_LIMIT_ENABLED=true
# TERRA_RATE_LIMIT_PER_MINUTE=120
# TERRA_MAX_REQUEST_BODY_BYTES=1048576

# --------------------------------------------------------------------------- #
# Production (docker-compose.prod.yml + docker-compose.monitoring.yml)         #
# --------------------------------------------------------------------------- #
# Postgres and Redis are MANAGED cloud services in this topology (Neon /
# Upstash) — no bundled containers. All five are REQUIRED (compose fails fast):
# TERRA_POSTGRES_HOST=ep-xxxx.aws.neon.tech
# TERRA_POSTGRES_USER=terra
# TERRA_POSTGRES_PASSWORD=
# TERRA_POSTGRES_DB=terra
# TERRA_REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
# TLS mode for Postgres (defaults to "require" in the prod compose):
# TERRA_POSTGRES_SSLMODE=require
#
# Public origin of the deployment — REQUIRED. Used as the OAuth issuer /
# resource identifier and to build the Google login callback URL:
# TERRA_AUTH_ISSUER_URL=https://your-domain.example
# Browser landing origin after Google login (defaults to the issuer above):
# TERRA_FRONTEND_BASE_URL=https://your-domain.example
#
# AI pipeline for /ask (LiteLLM route + provider key; /ask returns 503 without a key):
# TERRA_LLM_MODEL=gemini/gemini-2.5-flash
# TERRA_LLM_API_KEY=
# "Sign in with Google" (optional; button hidden when unset):
# TERRA_GOOGLE_OAUTH_CLIENT_ID=
# TERRA_GOOGLE_OAUTH_CLIENT_SECRET=
#
# The frontend talks to the backend through Nginx, so the API base is a path:
# NEXT_PUBLIC_API_BASE_URL=/api/v1
# NEXT_PUBLIC_API_DOCS_URL=/docs
# Grafana admin password for the monitoring overlay (change from the default!).
# GRAFANA_ADMIN_PASSWORD=change-me-please

# --- Production security (secure-by-default; see docs/security.md) ---------- #
# Auth is ON by default in the prod topology and the app REFUSES TO START with
# it off in production. A bootstrap admin token is REQUIRED (compose fails fast
# without it) — it guards token issuance; generate a strong random value:
#   TERRA_AUTH_ADMIN_TOKEN=$(openssl rand -hex 32)
TERRA_AUTH_ADMIN_TOKEN=
# Override only to disable (rejected in prod) — leave unset for the secure default.
# TERRA_AUTH_ENABLED=true
# CORS defaults to same-origin only ("[]"). Set a JSON allow-list here ONLY for a
# separate browser app on another origin; '*' is rejected in production.
# TERRA_CORS_ORIGINS=["https://app.example.com"]
#
# TLS: drop fullchain.pem + privkey.pem into deployment/nginx/certs/ before
# exposing the service. Nginx serves :443 and redirects :80 -> HTTPS.
#
# Google Earth Engine (SRS §19.3): the key is mounted read-only as a Docker
# secret from ./secrets/terra-gee.json (never committed). ROTATE it before
# production and load the replacement from your secret store. Supply the account
# identity here:
# GEE_SERVICE_ACCOUNT=terra-gee@<project>.iam.gserviceaccount.com
# GEE_PROJECT=<gcp-project-id>
